{
    "name": "pcba-gateway",
    "private": true,
    "type": "module",
    "engines": { "bun": ">=1.4.2" },
    "scripts": {
        "start": "bun src/server.ts",
        "generate": "cd ../actors && durable-actors generate && rm -rf ../gateway/generated && cp -r generated ../gateway/generated",
        "check": "tsc --noEmit"
    },
    "dependencies": { "durable-actors": "0.14.6" },
    "devDependencies": { "@types/bun": "^1.2.0", "typescript": "~5.9.3" },
    "trustedDependencies": ["esbuild"]
}
